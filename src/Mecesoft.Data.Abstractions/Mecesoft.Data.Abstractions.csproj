    <RootNamespace>Mecesoft.Data.Abstractions</RootNamespace>
    <PackageId>Mecesoft.Data.Abstractions</PackageId>
    <Description>Provider-independent data access abstractions for Mecesoft.Data.</Description>
    <PackageTags>mecesoft;data-access;abstractions</PackageTags>
