<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Mecesoft.Data.EntityFrameworkCore</AssemblyName>
    <RootNamespace>Mecesoft.Data.EntityFrameworkCore</RootNamespace>
    <PackageId>Mecesoft.Data.EntityFrameworkCore</PackageId>
    <Description>EF Core relational integration for Mecesoft.Data.</Description>
    <PackageTags>mecesoft;data-access;entity-framework-core</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Mecesoft.Data.Abstractions/Mecesoft.Data.Abstractions.csproj" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Mecesoft.Data.EntityFrameworkCore.SqlServer.Tenancy" />
    <InternalsVisibleTo Include="Mecesoft.Data.EntityFrameworkCore.SqlServer.Tests" />
    <InternalsVisibleTo Include="Mecesoft.Data.EntityFrameworkCore.PostgreSql.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" Link="README.md" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" Link="LICENSE" />
  </ItemGroup>
</Project>
