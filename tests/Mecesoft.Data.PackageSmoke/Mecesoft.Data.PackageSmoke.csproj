<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
    <IncludeSymbols>false</IncludeSymbols>
    <EnableSourceLink>false</EnableSourceLink>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <NoWarn>$(NoWarn);CA1050</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Mecesoft.Data.Abstractions" Version="1.1.0" />
    <PackageReference Include="Mecesoft.Data.EntityFrameworkCore" Version="1.1.0" />
    <PackageReference Include="Mecesoft.Data.EntityFrameworkCore.SqlServer.Tenancy" Version="1.1.0" />
    <PackageReference Include="Mecesoft.Data.EntityFrameworkCore.PostgreSql.Tenancy" Version="1.1.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
  </ItemGroup>
</Project>
